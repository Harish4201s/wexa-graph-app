# CognoDB connection (openCypher over Bolt — Neo4j-driver compatible)
# Never commit a real .env file. Copy this to .env and fill in your values.

COGNODB_URI=bolt://localhost:7687
COGNODB_USER=neo4j
COGNODB_PASSWORD=changeme
COGNODB_DATABASE=neo4j

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
